{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brain-mcp",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  // run_code (code mode) needs the Workers Paid plan and this binding; the tool stays
  // hidden without it. ctx.exports is on by default at this compatibility date.
  // "worker_loaders": [{ "binding": "LOADER" }],
  // Semantic memory (hybrid search) needs both of these. First:
  //   npx wrangler vectorize create brain-notes --dimensions=1024 --metric=cosine
  // "ai": { "binding": "AI" },
  // "vectorize": [{ "binding": "VECTORS", "index_name": "brain-notes" }],
  // and add "MEMORY_MIN_SCORE": "0.45" to vars: bge-m3 scores unrelated notes around 0.3-0.4.
  "observability": { "enabled": true },
  // React SPA (ui/) served as static assets from the root; the Worker keeps
  // first claim on the API/OAuth/MCP routes below.
  "assets": {
    "directory": "ui/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/mcp",
      "/webhook",
      "/ingest/*",
      "/hooks/*",
      "/admin/*",
      "/app",
      "/app/*",
      "/authorize",
      "/token",
      "/register",
      "/.well-known/*",
      "/health",
      "/skills/*",
      "/invite/*",
      "/export/*",
      "/connect/*",
      "/device",
      "/device/*",
      "/bridge/*"
    ]
  },
  // brain.yashlunawat.com is attached as a Workers custom domain in the dashboard.
  // Deliberately NOT declared here: managing it from CI requires Zone->Workers
  // Routes:Edit on the API token, which the CI token intentionally doesn't have.
  // If the domain ever detaches, re-add it in dash -> Workers -> brain-mcp -> Domains.
  // workers.dev stays on (the GitHub webhook points at it, see scripts/setup.sh), but
  // per-version Preview URLs are off: an old version must not serve production bindings.
  "preview_urls": false,
  "vars": {
    "REPO": "Yash121l/brain",
    "BRANCH": "main",
    "SUPER_HANDLE": "yash"
  },
  "durable_objects": {
    "bindings": [
      { "name": "SPACES", "class_name": "SpaceDO" },
      { "name": "AUDIT", "class_name": "AuditDO" },
      // one per upstream account: serializes token refresh, keeps the upstream session warm
      { "name": "CONNECTIONS", "class_name": "ConnectionDO" },
      // one per machine: the brain CLI's local-server bridge holds a WebSocket here
      { "name": "BRIDGE", "class_name": "BridgeDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SpaceDO", "AuditDO"] },
    { "tag": "v2", "new_sqlite_classes": ["ConnectionDO", "BridgeDO"] }
  ],
  "ratelimits": [
    { "name": "MCP_LIMITER", "namespace_id": "4101", "simple": { "limit": 300, "period": 60 } },
    { "name": "AUTH_LIMITER", "namespace_id": "4102", "simple": { "limit": 20, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brain-index",
      "database_id": "25f6c237-b741-4a94-856b-4c82381ac93c"
    }
  ],
  // Cold storage for tool-call telemetry. The nightly cron drains the D1
  // tool_calls buffer into one object per session per day.
  "r2_buckets": [
    {
      "binding": "LOGS",
      "bucket_name": "brain-logs"
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  }
  // secrets (wrangler secret put): BRAIN_TOKEN, GITHUB_TOKEN, WEBHOOK_SECRET, BRAIN_KEK, VAULT_KEK
}
